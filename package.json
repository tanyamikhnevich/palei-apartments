{
  "name": "palei-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:cars:generate": "drizzle-kit generate --config drizzle.cars.config.ts",
    "db:cars:migrate": "tsx src/db/cars/migrate.ts",
    "db:flowers:generate": "drizzle-kit generate --config drizzle.flowers.config.ts",
    "db:flowers:migrate": "tsx src/db/flowers/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-leaflet": "^4.2.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "sass": "^1.77.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0"
  }
}
