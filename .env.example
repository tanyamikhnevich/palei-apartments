# Neon PostgreSQL (Dashboard → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: protect the scheduled calendar sync (GET /api/calendar/sync).
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=your-random-secret

# Optional: Telegram notifications for new booking requests and messages from
# the contact form (the contact form has no other destination — without these
# it answers with an error instead of silently dropping the message)
# 1) Create a bot with @BotFather -> copy the token
# 2) Add the bot to your channel as an admin
# 3) chat_id is @your_channel (public) or the -100... numeric id (private)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=@your_channel

# Optional: a separate database for the car fleet. Without it the fleet keeps
# its own tables (cars, car_blocks) inside DATABASE_URL — still separate tables,
# separate migrations and no foreign keys to the apartments.
#   npm run db:cars:generate   # write SQL from the schema
#   npm run db:cars:migrate    # apply it
# CARS_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/fleet?sslmode=require

# Optional: a separate database for the flower shop, same idea as the fleet.
#   npm run db:flowers:generate
#   npm run db:flowers:migrate
# FLOWERS_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/shop?sslmode=require

# Vercel Blob (Storage -> Blob -> Tokens). Without it uploads fall back to
# public/uploads, which does NOT survive a deploy on Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Admin panel. The login and password are NOT here — they live in the database.
# Create the account once:
#   npm run db:migrate
#   npm run admin:create -- 'your-login' 'your-password'
# After that the password is changed from the panel itself (Settings -> Account).
#
# ADMIN_SECRET signs the session tokens. It is infrastructure, not a credential:
# nobody types it. Required. Any long random string; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every browser out at once.
ADMIN_SECRET=your-random-secret
